// firestore.rules
//
// PERUBAHAN DESAIN #1 (login santri): password diverifikasi lewat
// FIREBASE AUTH (email sintetis `username@quranreport-parent.app`),
// BUKAN `passwordHash` yang dibaca dari Firestore — supaya password
// tidak pernah perlu dibuka ke client sebelum auth (lihat README.md).
//
// PERUBAHAN DESAIN #2 (admin, versi TANPA Cloud Functions/Blaze):
// admin login lewat akun Firebase Auth SUNGGUHAN (bukan cuma PIN lokal
// di client) — emailnya dicek langsung di rules lewat
// `isAdmin()`. Ini menghindari kebutuhan Cloud Functions generasi-2
// yang WAJIB plan Blaze — semuanya jalan di plan Spark (gratis).
// Trade-off: daftar admin di-hardcode di rules (perlu re-deploy rules
// kalau mau tambah/hapus admin) — untuk 1 sekolah dengan 1-2 admin,
// ini lebih simpel daripada infra Cloud Functions.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/{schoolId} {
      function myAccount() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/santriAccounts/$(request.auth.uid)).data;
      }
      function myStudent() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/students/$(myAccount().studentId)).data;
      }
      // GANTI daftar ini kalau mau tambah/hapus admin — harus di-deploy
      // ulang (`firebase deploy --only firestore:rules`) tiap ubah.
      function isAdmin() {
        return request.auth != null &&
          request.auth.token.email in [
            'admin@quranreport-admin.app'
          ];
      }
      // app guru pakai auth lokalnya sendiri (bukan Firebase Auth), jadi
      // butuh identitas di mata Firestore buat bisa nulis. Sign-in
      // ANONIM dipakai khusus untuk ini — santri/admin SELALU login
      // pakai email+password (isAdmin()/myAccount() di atas), jadi
      // provider anonim = pasti bukan mereka, aman dibedakan.
      //
      // DIPINDAH ke atas (sebelumnya didefinisikan di bawah match
      // santriAccounts/students) karena sekarang dipakai juga di rule
      // kedua match itu — lihat catatan "BERUBAH" di masing-masing.
      function isGuruApp() {
        return request.auth != null &&
          request.auth.token.firebase.sign_in_provider == 'anonymous';
      }
      // <-- BARU: seluruh match ini. Collection `accounts` (data guru/
      // admin: username, passwordHash awal, displayName, assignments
      // kelas+halaqoh, flag isAdmin) — dipakai ApiAuthRepository, fitur
      // baru yang bikin admin bisa edit assignment guru dari dalam app
      // (menu "Kelola Akun Guru") TANPA build ulang APK, plus tombol
      // "Migrasi Data Guru & Murid ke Cloud" (migrateSeedToFirestore).
      // JANGAN disamakan dengan `santriAccounts` di atas — itu punya
      // SANTRI/Portal Ortu, beda sama sekali. Sebelum blok ini
      // ditambahkan, collection ini nggak ke-cover rule manapun ->
      // default-deny Firestore bikin refresh()/updateAssignments()/
      // migrateSeedToFirestore() semua permission-denied. Cuma app guru
      // (anonim) yang pernah baca/tulis collection ini — santri/admin
      // Portal Ortu tidak pernah butuh data guru.
      match /accounts/{accountId} {
        allow read, write: if isGuruApp();
      }
      // Akun santri:
      //  - santri baca dokumennya sendiri (uid = ID dokumen)
      //  - admin baca/tulis SEMUA (buat akun baru, nonaktifkan)
      //  - <-- BERUBAH: isGuruApp() ditambah di allow write. Fitur
      //    "Migrasi Data Guru & Murid ke Cloud" (admin LOKAL app guru,
      //    tombol di Pengaturan) nulis ke sini, tapi app guru SELALU
      //    sign-in anonim ke Firebase (isGuruApp()) — gak pernah punya
      //    sesi Firebase Auth ber-email admin (isAdmin() di atas itu
      //    khusus buat admin Portal Ortu/Console, identitas yang BEDA).
      //    Tanpa ini, migrasi selalu permission-denied walau yang
      //    mencet tombolnya admin di app guru. Trade-off yang disadari:
      //    ini nyamain level trust isGuruApp() dengan collection lain
      //    yang app guru tulis (santriRecords, dst) — UI-nya sendiri
      //    tetap menyembunyikan tombol ini dari guru pembimbing biasa
      //    (lihat "Kelola Sekolah (Admin)" di settings_screen.dart),
      //    tapi dari sisi Firestore, semua sesi app guru anonim setara.
      match /santriAccounts/{accountId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == accountId);
        allow write: if isAdmin() || isGuruApp();
      }
      // Data master santri:
      //  - santri baca datanya sendiri
      //  - admin baca semua (buat pilih santri saat bikin akun)
      //  - <-- BERUBAH: dulu `allow write: if false` total (niatnya:
      //    read-only, cuma diisi lewat script seed manual). Sekarang
      //    isGuruApp() boleh nulis juga, khusus buat fitur "Migrasi
      //    Data Guru & Murid ke Cloud" (ApiStudentRepository.
      //    migrateSeedToFirestore) — sekali-jalan, upsert per id,
      //    dipicu admin LOKAL dari app guru. Sama trade-off-nya kayak
      //    santriAccounts di atas: gak ada cara bedain "admin lokal"
      //    vs "guru pembimbing biasa" di level Firestore selama
      //    keduanya sama-sama anonim, jadi trust-nya di-generalisasi
      //    ke seluruh isGuruApp() — ditutup di sisi UI, bukan di rules.
      match /students/{studentId} {
        allow read: if isAdmin() || (request.auth != null && myAccount().studentId == studentId);
        allow write: if isGuruApp();
      }
      // Laporan — SantriRecord tidak punya studentId (desain existing
      // app guru), jadi dicek kelas+halaqoh+namaAnak cocok dengan
      // Student milik si pembaca — genuinely dicek di rules, bukan
      // cuma filter di query client.
      match /santriRecords/{recordId} {
        allow read: if isGuruApp() || (request.auth != null && !isAdmin() &&
          myStudent().nama == resource.data.namaAnak &&
          myStudent().kelas == resource.data.kelas &&
          myStudent().halaqoh == resource.data.halaqoh);
        allow write: if isGuruApp(); // mirror-write dari app guru
      }
      // Metadata "kartu identitas kosong" (santri yang sudah diaktifkan
      // di app guru tapi belum ada laporannya) — dipakai fitur
      // "Pulihkan dari Cloud" biar kartu kosong itu juga ikut balik
      // nama aslinya (bukan huruf kecil semua) kalau data lokal HP guru
      // hilang. Cuma app guru yang pernah baca/tulis dokumen ini,
      // santri/admin tidak pernah butuh ini sama sekali.
      match /appMeta/{docId} {
        allow read, write: if isGuruApp();
      }
      // Folder laporan (organisasi guru) — dipakai fitur mirror-backup &
      // "Pulihkan dari Cloud" di app guru (StorageService.upsertFolder/
      // deleteFolder/restoreFoldersFromFirestore). Cuma app guru yang
      // pernah baca/tulis dokumen ini.
      match /reportFolders/{folderId} {
        allow read, write: if isGuruApp();
      }
      // Catatan dari orang tua ke guru — app guru (anonim) baca semua
      // (buat badge/notifikasi live) dan HANYA boleh update field
      // `isRead`/`dismissed`. Santri (Portal Ortu) boleh baca riwayat
      // catatan MILIKNYA sendiri, dan boleh membuat catatan baru selama
      // studentId-nya cocok akun yang sedang login serta isRead dikirim
      // false.
      match /parentNotes/{noteId} {
        allow read: if isGuruApp();
        allow update: if isGuruApp() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'dismissed']);

        allow read: if request.auth != null && !isAdmin() && !isGuruApp() &&
          resource.data.studentId == myAccount().studentId;
        allow create: if request.auth != null && !isAdmin() && !isGuruApp() &&
          request.resource.data.studentId == myAccount().studentId &&
          request.resource.data.isRead == false;

        allow write: if isAdmin();
      }
      // Rekap pekanan (1 dokumen = 1 santri = 1 pekan — lihat catatan
      // arsitektur di WeeklyRecapDeployService & model WeeklyRecap di
      // Portal Ortu) yang di-deploy manual dari tombol "Deploy" di
      // GenerateRekapPekananScreen (app guru).
      // App guru (anonim) tulis; santri (Portal Ortu) cuma boleh baca
      // dokumen MILIK ANAKNYA SENDIRI (kelas+halaqoh+nama harus cocok
      // tiga-tiganya, persis pola santriRecords) — BUKAN "seluruh kelas
      // boleh baca", supaya data anak lain sekelas (nama, catatan guru)
      // tidak pernah ke-expose ke orang tua lain, walau cuma lewat
      // network inspector.
      match /weeklyRecaps/{recapId} {
        allow write: if isGuruApp();
        allow read: if isGuruApp();
        allow read: if request.auth != null && !isAdmin() && !isGuruApp() &&
          myStudent().kelas == resource.data.kelas &&
          myStudent().halaqoh == resource.data.halaqoh &&
          myStudent().nama.lower() == resource.data.namaAnakLower;
      }
    }
  }
}
