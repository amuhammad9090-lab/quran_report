// firestore.rules — DRAFT skema baru (nested per-guru)
//
// PERUBAHAN UTAMA vs rules lama:
// Data operasional guru (laporan/santriRecords, folder, parentNotes,
// weeklyRecaps, appMeta) dipindah jadi SUBCOLLECTION di bawah
// `accounts/{accountId}` masing-masing guru, BUKAN koleksi flat lagi.
// Ini menutup celah keamanan lama: sebelumnya SEMUA guru ke-whitelist
// (isGuruApp()) otomatis boleh baca+TULIS seluruh data guru LAIN (semua
// santriRecords/reportFolders/parentNotes/weeklyRecaps sekolah, bukan
// cuma miliknya sendiri) karena rules lama tidak pernah cek "punya
// siapa". Sekarang isolasinya struktural lewat path, bukan cuma logic
// client.
//
// Konteks 1 halaqoh = SELALU 1 guru (dikonfirmasi user) -- makanya path
// `accounts/{accountId}/laporan/{recordId}` sudah cukup unik buat 1
// kelas+halaqoh tanpa perlu skema duplikasi/co-teaching.
//
// PENTING -- WAJIB SEBELUM DEPLOY:
// 1. Tetap butuh 1 dokumen `accountsByEmail` manual buat admin pertama
//    (sama seperti rules lama -- lihat komentar panjang di versi lama).
// 2. `students/{studentId}` sekarang WAJIB ada field baru `guruAccountId`
//    (ditulis ApiStudentRepository saat kelas/halaqoh di-set) SEBELUM
//    Portal Ortu bisa resolve ke subcollection guru yang benar.
// 3. Refactor Dart-nya (ApiAuthRepository.findByGoogleEmail dkk) HARUS
//    naik bareng rules ini, jangan deploy terpisah -- kalau rules ini
//    naik duluan sebelum kode guru diubah, fitur yang masih baca/tulis
//    ke koleksi flat lama (santriRecords/reportFolders/dst di root
//    schoolId) bakal permission-denied karena match block-nya sudah
//    dihapus dari rules ini.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/{schoolId} {

      // ---------- Helper functions ----------

      function myAccount() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/santriAccounts/$(request.auth.uid)).data;
      }
      function myStudent() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/students/$(myAccount().studentId)).data;
      }
      // <-- BERUBAH: ditambah a.muhammad9090@gmail.com. Root cause login
      // gagal ("permission-denied" di ApiAuthRepository.refresh()): akun
      // ini punya `role: "admin"` di dokumen accounts/usr_01 (dipakai
      // CLIENT buat nentuin apakah perlu full-collection get semua akun
      // guru), tapi server isAdmin() di sini cuma percaya satu email
      // hardcode -- jadi client mikir dia admin & nyoba baca SEMUA
      // accounts/*, sementara server nolak (bukan admin menurut daftar
      // ini) -> permission-denied. Gap ini sudah ada sejak migrasi ke
      // isAdmin()/isOwnAccount(), cuma baru ketauan sekarang.
      function isAdmin() {
        return request.auth != null &&
          request.auth.token.email in [
            'admin@quranreport-admin.app',
            'a.muhammad9090@gmail.com'
          ];
      }
      function isGuruApp() {
        return request.auth != null &&
          request.auth.token.firebase.sign_in_provider == 'google.com' &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/schools/$(schoolId)/accountsByEmail/$(request.auth.token.email.lower()));
      }
      // <-- BARU: accountId milik guru yang SEDANG login (dari index
      // accountsByEmail, bukan scan seluruh accounts). Dipakai buat
      // membedakan "punya sendiri" vs "punya guru lain" di semua
      // subcollection nested di bawah accounts/{accountId}.
      function myGuruAccountId() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/accountsByEmail/$(request.auth.token.email.lower())).data.accountId;
      }
      function isOwnAccount(accountId) {
        return isGuruApp() && myGuruAccountId() == accountId;
      }

      // ---------- Data global (tetap flat) ----------

      // Index kecil email -> accountId. Dibaca isGuruApp()/myGuruAccountId()
      // (lewat get()/exists(), operasi rules-internal), dan tetap perlu
      // allow read/write eksplisit untuk dibaca langsung dari client
      // (ApiAuthRepository) & ditulis admin (KelolaGuruScreen).
      // <-- BERUBAH (audit keamanan): dulu `allow read: if isGuruApp();`
      // — SEMUA guru bisa baca SELURUH directory email->accountId guru
      // lain di sekolah (info disclosure, bukan cuma milik sendiri).
      // Dicek ulang ke `api_auth_repository.dart`: client CUMA pernah
      // baca dokumen emailnya SENDIRI saat login (findByGoogleEmail),
      // kecuali dari layar admin (updateGoogleEmail, yang sudah pasti
      // isAdmin()) — jadi ketatin ke situ TIDAK mematahkan fitur mana pun.
      match /accountsByEmail/{email} {
        allow read: if isAdmin() || (isGuruApp() && email == request.auth.token.email.lower());
        allow write: if isAdmin();
      }

      // Data master santri (dipakai autocomplete + Portal Ortu resolve
      // guruAccountId). Field baru `guruAccountId` ditulis di sini juga.
      //
      // <-- BERUBAH (audit keamanan): dulu `allow write: if isGuruApp();`
      // — SEMUA guru (bukan cuma admin) bisa create/update/DELETE
      // dokumen `students/{id}` milik guru LAIN, termasuk menimpa field
      // `guruAccountId` — field yang justru jadi dasar Portal Ortu
      // resolve ke subcollection accounts/{accountId} yang benar. Dicek
      // ke `api_student_repository.dart`: SEMUA method tulis
      // (updateKelasHalaqoh/bulkUpdateKelasHalaqoh/migrateSeedToFirestore)
      // cuma pernah dipanggil dari layar admin (Kelola Data/Kelola
      // Murid) — komentarnya sendiri bilang "pengecekan role dilakukan
      // di layer UI, bukan di sini". Diketatin match kenyataan
      // pemakaian app: admin-only di level rules juga, bukan cuma UI.
      match /students/{studentId} {
        allow read: if isAdmin() || isGuruApp() || (request.auth != null && myAccount().studentId == studentId);
        allow write: if isAdmin();
      }

      // Akun santri/Portal Ortu (login) -- tidak berubah dari rules lama.
      match /santriAccounts/{accountId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == accountId);
        allow write: if isAdmin();
        allow update: if request.auth != null && request.auth.uid == accountId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoBase64', 'photoUpdatedAt']);
      }

      // Info versi terbaru app Android/web (fitur update in-app), dipakai
      // app guru (`appConfig/guru_android`) dan Portal Orang Tua
      // (`appConfig/parent_android`). Isinya cuma nomor versi + link APK +
      // changelog (tidak sensitif) => read publik. Tulis cuma admin (atau
      // lewat Firebase Console).
      match /appConfig/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Metadata versi cache `students` (global, bukan per-guru).
      match /metadata/{docId} {
        allow read, write: if isGuruApp();
      }

      // ---------- Collection-group queries (admin restore) ----------

      // <-- BARU (bug fix): "Pulihkan dari Cloud" mode admin (lihat
      // RecordsRemoteSource.fetchRecords/fetchFolders) pakai
      // `collectionGroup('laporan')`/`collectionGroup('folders')` buat
      // baca lintas SEMUA guru sekaligus, BUKAN baca satu path
      // `accounts/{accountId}/laporan` tertentu. Rule nested biasa di
      // `match /accounts/{accountId} { match /laporan/{recordId} {...} } }`
      // di bawah TIDAK berlaku buat collectionGroup query walau path-nya
      // sama persis -- Firestore mewajibkan rule TERPISAH pakai wildcard
      // `{path=**}` supaya izin collectionGroup dievaluasi. Tanpa ini,
      // query-nya ditolak DI DEPAN (sebelum sempat cek isAdmin() sama
      // sekali) -> permission-denied walau email admin sudah benar.
      // Read-only (admin) -- tulis tetap lewat rule nested biasa di bawah.
      match /{path=**}/laporan/{recordId} {
        allow read: if isAdmin();
      }
      match /{path=**}/folders/{folderId} {
        allow read: if isAdmin();
      }

      // ---------- Data per-guru (BARU: nested) ----------

      match /accounts/{accountId} {
        // Profil guru sendiri. Admin boleh kelola semua (Kelola Akun
        // Guru); guru biasa CUMA boleh baca/tulis profilnya sendiri --
        // beda dari rules lama yang isGuruApp() bebas ke semua akun.
        allow read: if isAdmin() || isOwnAccount(accountId);
        allow write: if isAdmin() || isOwnAccount(accountId);

        // Laporan (ex-santriRecords, flat di root). Guru cuma akses
        // subcollection-nya sendiri; admin semua (lewat isAdmin() di
        // sini, ATAU collectionGroup('laporan') buat lintas-guru).
        match /laporan/{recordId} {
          allow read, write: if isAdmin() || isOwnAccount(accountId);
          // Portal Ortu: baca laporan ANAKNYA sendiri, cocokkan
          // kelas+halaqoh+nama (pola sama seperti rules lama) --
          // aman karena 1 halaqoh = 1 guru, jadi cuma ada SATU
          // accountId yang mungkin punya record dengan kombinasi ini.
          //
          // <-- BERUBAH (audit keamanan, defense-in-depth): ditambah
          // `accountId == myStudent().guruAccountId`. Sebelumnya rule
          // ini cuma cek kelas+halaqoh+nama TANPA peduli accountId-nya
          // — aman SELAMA asumsi "1 halaqoh = 1 guru" selalu tepat di
          // data. Kalau suatu saat data kecampur lagi (mis. bug sinkron
          // atau migrasi yang salah taruh dokumen di accountId yang
          // salah), tanpa penjepit ini orang tua tetap bisa kebaca
          // laporan dari accountId yang salah selama kelas+halaqoh+nama
          // kebetulan cocok. Sekarang dikunci juga ke accountId yang
          // resmi tercatat di students/{id}.guruAccountId.
          allow read: if request.auth != null && !isAdmin() && !isGuruApp() &&
            accountId == myStudent().guruAccountId &&
            myStudent().nama == resource.data.namaAnak &&
            myStudent().kelas == resource.data.kelas &&
            myStudent().halaqoh == resource.data.halaqoh;
        }

        // Folder laporan (ex-reportFolders, flat di root).
        match /folders/{folderId} {
          allow read, write: if isAdmin() || isOwnAccount(accountId);
        }

        // "Kartu identitas kosong" (ex-appMeta, flat di root).
        match /appMeta/{docId} {
          allow read, write: if isAdmin() || isOwnAccount(accountId);
        }

        // Catatan dari orang tua ke guru (ex-parentNotes, flat di root).
        match /parentNotes/{noteId} {
          allow read: if isAdmin() || isOwnAccount(accountId);
          allow update: if isOwnAccount(accountId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'dismissed']);

          // Portal Ortu: baca riwayat catatan miliknya + buat catatan baru.
          // <-- BERUBAH (audit keamanan, defense-in-depth): dikunci juga
          // ke accountId = guruAccountId santrinya sendiri, sama alasan
          // seperti di /laporan di atas.
          allow read: if request.auth != null && !isAdmin() && !isGuruApp() &&
            accountId == myStudent().guruAccountId &&
            resource.data.studentId == myAccount().studentId;
          allow create: if request.auth != null && !isAdmin() && !isGuruApp() &&
            accountId == myStudent().guruAccountId &&
            request.resource.data.studentId == myAccount().studentId &&
            request.resource.data.isRead == false;
        }

        // Rekap pekanan yang di-deploy ke orang tua (ex-weeklyRecaps,
        // flat di root).
        match /weeklyRecaps/{recapId} {
          allow read, write: if isAdmin() || isOwnAccount(accountId);
          // <-- BERUBAH (audit keamanan, defense-in-depth): dikunci juga
          // ke accountId = guruAccountId santrinya sendiri, sama alasan
          // seperti di /laporan di atas.
          allow read: if request.auth != null && !isAdmin() && !isGuruApp() &&
            accountId == myStudent().guruAccountId &&
            myStudent().kelas == resource.data.kelas &&
            myStudent().halaqoh == resource.data.halaqoh &&
            myStudent().nama.lower() == resource.data.namaAnakLower;
        }
      }
    }
  }
}
