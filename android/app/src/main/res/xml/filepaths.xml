<?xml version="1.0" encoding="utf-8"?>
<!-- Dipakai FileProvider (update APK in-app / ota_update, dan membuka file hasil ekspor lewat open_filex).
     Hasil ekspor disimpan di getApplicationDocumentsDirectory() = /data/data/<paket>/app_flutter,
     jadi folder itu HARUS tercakup di sini (root-path), kalau tidak -> "Failed to find configured root". -->
<paths>
    <root-path name="root" path="." />
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-path name="external" path="." />
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
</paths>
