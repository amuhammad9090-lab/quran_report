<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Sebelumnya @android:color/black di sini — itu penyebab splash
         "ilang warna" pas dark mode (kedip hitam polos sebelum gradient
         hijau Flutter sempat digambar). Disamakan sama versi light: tetap
         hijau brand, bukan warna netral yang beda-beda per tema. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_native_bg</item>
    </style>
</resources>
